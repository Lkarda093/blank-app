{
  "name": "Aurora 0.1",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "22" } },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Aurora", "onAutoForward": "notify", "visibility": "private" },
    "8000": { "label": "API interna", "onAutoForward": "ignore" }
  },
  "remoteEnv": { "PIP_DISABLE_PIP_VERSION_CHECK": "1" }
}
