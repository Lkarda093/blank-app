# Nunca envie este arquivo preenchido para o GitHub ou para um chat.
# Não coloque chaves de API neste arquivo.
# Windows: use Configurar-Aurora.cmd (Gerenciador de Credenciais).
# Servidor não Windows: GEMINI_API_KEY somente como segredo do ambiente.
# Identificadores de modelos de TEXTO disponíveis na sua conta, separados por vírgula.
# Consulte Google AI Studio. Sem configuração, o envio fica desabilitado.
GEMINI_MODELS=
# Gere com: python -c 'import secrets; print(secrets.token_urlsafe(32))'
AURORA_OWNER_TOKEN=
# Caminho relativo à pasta backend; não à pasta do terminal.
AURORA_DB_PATH=data/aurora.sqlite3

# Modelos cujo nível gratuito VOCÊ confirmou no seu projeto. Deve ser um subconjunto de GEMINI_MODELS.
# Vazio desativa a troca automática. Não há consulta de preços ou ativação de faturamento.
GEMINI_FREE_FALLBACK_MODELS=
